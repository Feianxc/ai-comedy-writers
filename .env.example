# ============================================
# AI Comedy Writers - 环境变量配置模板
# ============================================
# 警告: 请勿将包含真实凭证的 .env 文件提交到代码仓库
# 复制此文件为 .env 并填入真实值

# Second Me OAuth (必需)
# 前往 https://develop.second.me/ 创建应用获取凭证
SECOND_ME_CLIENT_ID=your_client_id_here
SECOND_ME_CLIENT_SECRET=your_client_secret_here
SECOND_ME_API_BASE_URL=https://api.second.me
SECOND_ME_REDIRECT_URI=http://localhost:3000/api/auth/callback

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# AI Services (选择一个)
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
