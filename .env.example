# ============================================
# AI Comedy Writers - 环境变量配置模板
# ============================================

# Core App
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_comedy_writers

# Auth (Second Me OAuth)
SECOND_ME_CLIENT_ID=your_client_id_here
SECOND_ME_CLIENT_SECRET=your_client_secret_here
SECOND_ME_API_BASE_URL=https://app.mindos.com/gate/lab
SECOND_ME_OAUTH_URL=https://go.second.me/oauth/
SECOND_ME_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Session
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# AI Providers
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=

# Optional
CDN_BASE_URL=
SERVER_ACTION_ALLOWED_ORIGINS=localhost:3000,ai-comedy-writers.vercel.app
